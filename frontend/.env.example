# =====================================================================
# Ice Stream Frontend — Environment Configuration Template
# =====================================================================
# Copy this file to .env or configure these variables in your hosting
# provider's dashboard (e.g., Vercel, Netlify, Cloudflare Pages).

# URL of your deployed Ice Stream FastAPI backend service
# Examples:
#   Local development (with Vite proxy): leave blank or set to /api
#   Production (Render): https://ice-stream-backend.onrender.com
#   Production (Railway): https://ice-stream-production.up.railway.app
#   Production (Fly.io): https://ice-stream-api.fly.dev
VITE_API_URL=https://your-backend-service.onrender.com

# Optional explicit WebSocket URL
# If omitted, Ice Stream automatically derives the wss:// endpoint from VITE_API_URL
VITE_WS_URL=wss://your-backend-service.onrender.com/ws

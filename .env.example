# Ice Stream — Environment Configuration Template
# Copy this to .env and configure for your environment
# NEVER commit .env with real secrets

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Kafka Configuration (External Provider)
KAFKA_BOOTSTRAP_SERVERS=YOUR_KAFKA_BROKER_URL:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_SASL_USERNAME=your_sasl_username
KAFKA_SASL_PASSWORD=your_sasl_password
KAFKA_TOPIC_TRANSACTIONS=ice-stream.transactions
KAFKA_TOPIC_DLQ=ice-stream.dlq
# Reserved for future: KAFKA_TOPIC_ALERTS=ice-stream.alerts
KAFKA_GROUP_ID=ice-stream-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# Storage Configuration
DUCKDB_PATH=data/ice_stream.duckdb
DATA_DIR=data/
CLEAN_DATA_PATH=data/clean/
QUARANTINE_DATA_PATH=data/quarantine/

# Backblaze B2 Object Storage (Master 5)
B2_BUCKET_NAME=ice-stream-lakehouse
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_ACCESS_KEY_ID=your_b2_key_id
B2_SECRET_ACCESS_KEY=your_b2_application_key

# Apache Iceberg Lakehouse (Master 5)
ICEBERG_CATALOG_NAME=ice_stream_catalog
ICEBERG_DATABASE=ice_stream
ICEBERG_WAREHOUSE=s3://ice-stream-lakehouse/warehouse
ICEBERG_CLEAN_TABLE=transactions_clean
ICEBERG_DLQ_TABLE=transactions_dlq
ICEBERG_CATALOG_DB_PATH=data/iceberg_catalog.db

# Pipeline Configuration
TRANSACTION_BATCH_SIZE=1000
VALIDATION_TIMEOUT_SECONDS=30
MAX_QUARANTINE_SIZE=100000

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# Observability & Real-Time Circuit Breaker (Master 6)
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.02
CIRCUIT_BREAKER_FAIL_FAST=true
OBSERVABILITY_DB_PATH=data/observability.db

# Database
DATABASE_URL=sqlite:///./data/ice_stream.db

# Debugging
DEBUG=false
VERBOSE_LOGGING=false

# Email / Contact Us SMTP Configuration
# Set EMAIL_PASSWORD to a 16-character Google App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password
SANTOSH_EMAIL=Sant7124@gmail.com
COPY_EMAIL=sanikamankar74@gmail.com

# Dual-Host Deployment / CORS Configuration
# When frontend is deployed on another website (e.g., Vercel, Netlify),
# list the frontend URL here (comma-separated if multiple):
# ALLOWED_ORIGINS=https://ice-stream.vercel.app,https://your-custom-domain.com
# Set to * to allow all origins during testing:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

